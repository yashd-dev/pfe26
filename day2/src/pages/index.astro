---
import "../styles/globals.css"
let navItems = ["Work", "About", "Contact"];
let filters = ["All", "Branding", "User Research", "UI/UX"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Homer Simpson</title>
  </head>
  <body>
    <nav>
      <a class="logo" href="/" aria-label="Home"></a>
      <div class="nav-items">
        {navItems.map((item) => <a class="nav-link" href="https://google.com">{item}</a>)}
      </div>
    </nav>

    <main>
      <section class="hero-card">
        <img src="https://www.onthisday.com/images/people/homer-simpson.jpg?w=360" alt="Homer Simpson" />
        <h1>Hi im Homer Simpson :)</h1>
        <p class="intro">
          I am very homeless but this is my site never the less :))) (please donate to me)
        </p>
      </section>
    </main>

    <footer>
      {filters.map((item) => <a class="button" href="https://google.com">{item}</a>)}
    </footer>
  </body>
</html>
