{
  "name": "api",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @api/db db:push",
    "db:studio": "bun run --filter @api/db db:studio",
    "db:generate": "bun run --filter @api/db db:generate",
    "db:migrate": "bun run --filter @api/db db:migrate",
    "db:seed": "bun run --filter @api/db db:seed",
    "db:local": "bun run --filter @api/db db:local",
    "docker:build": "docker build -t api .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file apps/server/.env api",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@api/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
